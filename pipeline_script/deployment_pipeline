pipeline {
    agent any

    environment {
        KUBECTL = '/usr/local/bin/kubectl'
    }

    parameters {
        string(name: 'CLUSTER_NAME', defaultValue: 'your-eks-cluster', description: 'Enter your EKS cluster name')
        string(name: 'AWS_REGION', defaultValue: 'us-east-1', description: 'Enter your AWS region')
        string(name: 'PROMETHEUS_NAMESPACE', defaultValue: 'prometheus', description: 'Enter Prometheus namespace')
        string(name: 'PROMETHEUS_RELEASE_NAME', defaultValue: 'prometheus-stack', description: 'Enter Prometheus Helm release name')
        string(name: 'ARGOCD_NAMESPACE', defaultValue: 'argocd', description: 'Enter ArgoCD namespace')
    }

    stages {
        stage("Login to EKS") {
            steps {
                script {
                    withCredentials([string(credentialsId: 'access-key', variable: 'AWS_ACCESS_KEY'),
                                     string(credentialsId: 'secret-key', variable: 'AWS_SECRET_KEY')]) {
                        sh "aws eks --region ${params.AWS_REGION} update-kubeconfig --name ${params.CLUSTER_NAME}"
                    }
                }
            }
        }

        stage("Configure Prometheus & Grafana") {
            steps {
                script {
                    sh """
                    helm repo add stable https://charts.helm.sh/stable || true
                    helm repo add prometheus-community https://prometheus-community.github.io/helm-charts || true
                    # Check if namespace '${params.PROMETHEUS_NAMESPACE}' exists
                    if kubectl get namespace ${params.PROMETHEUS_NAMESPACE} > /dev/null 2>&1; then
                        # If namespace exists, upgrade the Helm release
                        helm upgrade ${params.PROMETHEUS_RELEASE_NAME} prometheus-community/kube-prometheus-stack -n ${params.PROMETHEUS_NAMESPACE}
                    else
                        # If namespace does not exist, create it and install Helm release
                        kubectl create namespace ${params.PROMETHEUS_NAMESPACE}
                        helm install ${params.PROMETHEUS_RELEASE_NAME} prometheus-community/kube-prometheus-stack -n ${params.PROMETHEUS_NAMESPACE}
                    fi
                    kubectl patch svc ${params.PROMETHEUS_RELEASE_NAME}-kube-prometheus-sta-prometheus -n ${params.PROMETHEUS_NAMESPACE} -p '{"spec": {"type": "LoadBalancer"}}'
                    kubectl patch svc ${params.PROMETHEUS_RELEASE_NAME}-grafana -n ${params.PROMETHEUS_NAMESPACE} -p '{"spec": {"type": "LoadBalancer"}}'
                    """
                }
            }
        }

        stage("Configure ArgoCD") {
            steps {
                script {
                    sh """
                    # Install ArgoCD
                    kubectl create namespace argocd || true
                    kubectl apply -n argocd -f https://raw.githubusercontent.com/argoproj/argo-cd/stable/manifests/install.yaml
                    kubectl patch svc argocd-server -n argocd -p '{"spec": {"type": "LoadBalancer"}}'
                    """
                }
            }
        }
		
    }
}